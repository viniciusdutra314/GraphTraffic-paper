# Rebuild the environment when the local simulator or its JSON contract changes.
watch_file GraphTraffic-jl/flake.nix GraphTraffic-jl/flake.lock
watch_file GraphTraffic-jl/GraphTraffic-rs/flake.nix GraphTraffic-jl/GraphTraffic-rs/flake.lock
watch_file GraphTraffic-jl/GraphTraffic-rs/Cargo.toml GraphTraffic-jl/GraphTraffic-rs/Cargo.lock
watch_file GraphTraffic-jl/GraphTraffic-rs/build.rs GraphTraffic-jl/GraphTraffic-rs/schema.json
watch_file GraphTraffic-jl/GraphTraffic-rs/rust-toolchain.toml
watch_file GraphTraffic-jl/GraphTraffic-rs/src GraphTraffic-jl/GraphTraffic-rs/src/*.rs
watch_file GraphTraffic-jl/GraphTraffic-rs/tests GraphTraffic-jl/GraphTraffic-rs/tests/*.rs
use flake
